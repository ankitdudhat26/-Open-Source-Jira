{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Fingerprinted build assets (/assets/*) never change, and one page load requests hundreds of them.
	# Rate limiting them answered real page loads with 429 (an office behind one IP used up the budget),
	# so they are cached by the browser for a year and left out of the limit.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Per-client-IP rate limiting for every other request (index.html, icons, manifest, ...)
	@not_assets not path /assets/*
	rate_limit @not_assets {
		zone static {
			key {client_ip}
			events 300
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
