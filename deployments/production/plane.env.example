# Plane production settings (app stack).
# Copy to plane.env on the server (never commit plane.env) and fill in the values marked CHANGE.
#
# Database values must match the plane-database repository's .env
# (/opt/plane-database/.env on the server): POSTGRES_*, RABBITMQ_*, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY. Replace every CHANGE-ME with the same password used there.

# --- Images (deploy.sh updates these on every deploy) -------------------------
# ghcr.io/<your-github-user-or-org, lowercase>/<image name prefix>
IMAGE_PREFIX=ghcr.io/your-github-user
APP_RELEASE=latest

# CHANGE: your domain or server IP
APP_DOMAIN=localhost

WEB_REPLICAS=1
SPACE_REPLICAS=1
ADMIN_REPLICAS=1
API_REPLICAS=1
WORKER_REPLICAS=1
BEAT_WORKER_REPLICAS=1
LIVE_REPLICAS=1

LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

WEB_URL=http://${APP_DOMAIN}
DEBUG=0
CORS_ALLOWED_ORIGINS=http://${APP_DOMAIN}
API_BASE_URL=http://api:8000

# DB SETTINGS (served by the plane-database stack as host "plane-db")
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
# CHANGE: same password as POSTGRES_PASSWORD in plane-database/.env (also inside DATABASE_URL)
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=plane
POSTGRES_PORT=5432
DATABASE_URL=postgresql://plane:CHANGE-ME@plane-db:5432/plane

# REDIS SETTINGS (plane-database stack, host "plane-redis")
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=

# RabbitMQ Settings (plane-database stack, host "plane-mq")
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
# CHANGE: same password as RABBITMQ_PASSWORD in plane-database/.env (also inside AMQP_URL)
RABBITMQ_PASSWORD=CHANGE-ME
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:CHANGE-ME@plane-mq:5672/plane

# If SSL Cert to be generated, set CERT_EMAIl="email <EMAIL_ADDRESS>"
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
TRUSTED_PROXIES=0.0.0.0/0
SITE_ADDRESS=:80
CERT_EMAIL=



# For DNS Challenge based certificate generation, set the CERT_ACME_DNS, CERT_EMAIL
# CERT_ACME_DNS="acme_dns <CERT_DNS_PROVIDER> <CERT_DNS_PROVIDER_API_KEY>"
CERT_ACME_DNS=


# Secret Key — change this before deploying to production.
# Generate a secure value with: python3 -c "from django.utils.crypto import get_random_secret_key; print(get_random_secret_key())"
# or: openssl rand -hex 32
# CHANGE (required)
SECRET_KEY=change-this-key-on-deployment

# DATA STORE SETTINGS (MinIO in the plane-database stack, host "plane-minio")
USE_MINIO=1
AWS_REGION=
AWS_ACCESS_KEY_ID=plane-minio
# CHANGE: same value as AWS_SECRET_ACCESS_KEY in plane-database/.env
AWS_SECRET_ACCESS_KEY=CHANGE-ME
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# Gunicorn Workers
GUNICORN_WORKERS=1

# UNCOMMENT `DOCKER_PLATFORM` IF YOU ARE ON `ARM64` AND DOCKER IMAGE IS NOT AVAILABLE FOR RESPECTIVE `APP_RELEASE`
# DOCKER_PLATFORM=linux/amd64

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT=60/minute

# Per-IP throttle for anonymous authentication endpoints (magic-link
# generate / sign-in / sign-up, email sign-in). DRF format: "<n>/<period>"
# where period is second/minute/hour/day.
AUTHENTICATION_RATE_LIMIT=10/minute

# Live server environment variables — change this before deploying to production.
# Generate a secure value with: openssl rand -hex 32
# CHANGE (required)
LIVE_SERVER_SECRET_KEY=change-this-key-on-deployment

# Webhook IP allowlist — comma-separated IPs or CIDR ranges allowed as webhook targets
# even if they resolve to private networks (e.g. "10.0.0.0/8,192.168.1.0/24,172.16.0.5")
WEBHOOK_ALLOWED_IPS=

# Webhook hostname allowlist — comma-separated hostnames that bypass the private-IP
# SSRF check. Useful for trusted internal services whose container/service IPs are
# dynamic (e.g. "silo,silo.namespace.svc.cluster.local")
WEBHOOK_ALLOWED_HOSTS=
