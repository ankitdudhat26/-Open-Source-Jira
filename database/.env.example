# Plane database stack settings.
# Copy to .env on the server (never commit .env) and replace every CHANGE value.
#
# The same values must be set in the app's plane.env (repository -Open-Source-Jira,
# deployments/production/plane.env): see README.md → "Matching settings".

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=plane
# CHANGE: strong password, e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=plane

# --- RabbitMQ (Celery job queue) ------------------------------------------------
RABBITMQ_USER=plane
# CHANGE: strong password
RABBITMQ_PASSWORD=CHANGE-ME
RABBITMQ_VHOST=plane

# --- MinIO (file uploads) -------------------------------------------------------
AWS_ACCESS_KEY_ID=plane-minio
# CHANGE: strong password (MinIO root password, at least 8 characters)
AWS_SECRET_ACCESS_KEY=CHANGE-ME

# --- Backups (scripts/backup.sh) ---------------------------------------------------
# Folder on the server where backups are written, and how many days to keep them.
BACKUP_DIR=/opt/plane-database/backups
BACKUP_RETENTION_DAYS=14
